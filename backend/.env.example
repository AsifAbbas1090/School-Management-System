# Database (Supabase PostgreSQL + Prisma — see prisma/schema.prisma url + directUrl)
# Dashboard: Project > Connect > copy Session (5432) and Transaction (6543) pooler strings.
# User format is postgres.[PROJECT_REF] on the pooler host (not the plain "postgres" user).
# Encode reserved characters in the password (e.g. ! as %21).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Storage (for future logo uploads)
# STORAGE_BUCKET_URL=https://your-storage-bucket.supabase.co/storage/v1/object/public/logos
